
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Bibliotech - Médiathèque{% endblock %}</title>

        {% block stylesheets %}
            {{ importmap('app') }}
        {% endblock %}
    </head>
    <body>

        <header class="site-header">
            <div class="container header-content">
                <a href="{{ path('app_catalogue') }}" class="logo">
                    📚 Bibliotech
                </a>

                <nav>
                    <a
                        href="{{ path('app_catalogue') }}"
                        class="{{ app.current_route == 'app_catalogue' ? 'actif' : '' }}"
                    >
                        Catalogue
                    </a>

                    <a
                        href="{{ path('app_populaires') }}"
                        class="{{ app.current_route == 'app_populaires' ? 'actif' : '' }}"
                    >
                        Les plus empruntés
                    </a>
                </nav>

            </div>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer class="site-footer">
            <div class="container">
                <p>© {{ "now"|date("Y") }} Bibliotech - Votre médiathèque</p>
            </div>
        </footer>

    </body>
</html>
